# Base URL of the waitlist API (Supabase Edge Functions).
#
# Leave this EMPTY to keep registration switched off: the form then reports that
# registration is not connected, and no data is sent anywhere. It is the safe
# default and is what the frontend does until the privacy notice is approved.
#
# Local (supabase start):  http://127.0.0.1:54321/functions/v1
# Deployed EduPay project: https://sllwhfwvjngfsaapblin.supabase.co/functions/v1
#
# NEXT_PUBLIC_* values are inlined into the browser bundle. Only ever put the
# public API base URL here — never a key or other secret.
NEXT_PUBLIC_EDUPAY_API_URL=
